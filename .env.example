# Pullupsell Partners — Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and should NEVER be committed

# ============================================
# ANALYTICS & TRACKING
# ============================================
REACT_APP_GA_ID=G-XXXXXXXXXX
# Get this from: https://analytics.google.com
# Format: G-XXXXXXXXXX (46 chars)

# ============================================
# LEAD CAPTURE & WEBHOOKS
# ============================================
N8N_WEBHOOK_URL=https://n8n.yourinstance.com/webhook/pullupsell-leads
# n8n webhook URL for form submissions
# Will be provided when you set up n8n workflow

# ============================================
# EMAIL & NOTIFICATIONS
# ============================================
REACT_APP_EMAIL_SERVICE_KEY=
# Email service API key (SendGrid, Mailgun, or Resend)
# Used for sending confirmation emails to leads
# Get from: https://sendgrid.com (recommended)

REACT_APP_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
# Optional: Slack webhook to notify you when leads submit
# Set up at: https://api.slack.com/messaging/webhooks

# ============================================
# BOOKING & CALENDAR
# ============================================
REACT_APP_CALENDLY_ID=your_calendly_username
# Optional: For "Book a consultation" CTA
# Get from: https://calendly.com
# Format: just your username (e.g., "eric_pullupsell")

# ============================================
# PAYMENTS (Optional - Phase 3+)
# ============================================
REACT_APP_STRIPE_PUBLIC_KEY=pk_live_XXXXXXXXXX
# Optional: Only needed if selling products/services
# Get from: https://dashboard.stripe.com/apikeys

# ============================================
# CONTACT INFO (Displayed on page)
# ============================================
REACT_APP_CONTACT_EMAIL=eric.b@pullupsell.com
# Email shown on contact form

REACT_APP_CONTACT_PHONE=+1 (XXX) XXX-XXXX
# Phone shown on page (optional)

# ============================================
# SOCIAL LINKS
# ============================================
REACT_APP_LINKEDIN_URL=https://linkedin.com/in/your-profile
REACT_APP_TWITTER_URL=https://twitter.com/your_handle
REACT_APP_INSTAGRAM_URL=https://instagram.com/your_handle
REACT_APP_YOUTUBE_URL=https://youtube.com/@your_channel

# ============================================
# DATABASE & CRM (Phase 2+)
# ============================================
REACT_APP_AIRTABLE_BASE_ID=
# Airtable base ID (when migrating from Google Sheets)
# Get from: https://airtable.com/api

REACT_APP_AIRTABLE_TOKEN=
# Airtable personal access token
# Create at: https://airtable.com/create/tokens

# ============================================
# AI FEATURES (Phase 3+)
# ============================================
REACT_APP_AI_VOICE_API_KEY=
# Optional: For AI voice agent follow-up calls
# Supported: Twilio, Retell AI, or custom provider

# ============================================
# REFERRAL SYSTEM (Phase 2+)
# ============================================
REACT_APP_REFERRAL_REWARD_AMOUNT=50
# Amount in USD for referral rewards
# Default: $50 per successful referral

# ============================================
# SITE CONFIG
# ============================================
REACT_APP_SITE_URL=https://pullupsell.com
# Your production domain (for canonical tags, OG images)

REACT_APP_SITE_NAME=Pullupsell Partners
# Site name for meta tags

REACT_APP_ENVIRONMENT=development
# development | staging | production
